# Copie este arquivo para .env.local (que fica fora do git) e rode `npx expo start -c`.
# Variáveis EXPO_PUBLIC_ vão dentro do app e qualquer pessoa consegue ler:
# nunca coloque senha, token ou chave aqui.

# Endereço do Auth Server (cadastro, login e renovação dos tokens)
EXPO_PUBLIC_AUTH_URL=https://auth-service-production-36e0.up.railway.app

# Endereço do back-end principal (busca e detalhe dos Hosts, perfil do Tutor)
EXPO_PUBLIC_API_URL=https://backend-production-7298.up.railway.app
